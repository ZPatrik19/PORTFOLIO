# OpenAI agent mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AGENT_MODE=offline
AGENT_METHODOLOGY=plan_execute
MAX_AGENT_STEPS=8
APP_LANGUAGE=en

# local = deterministic CSV fixtures only
# auto  = try live Open-Meteo / Frankfurter, fall back to local data
# live  = require live APIs and fail if unavailable
TRAVEL_DATA_MODE=auto
