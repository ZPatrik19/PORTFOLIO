# Select one: mock | ollama | groq | gemini | openrouter | openai
LLM_PROVIDER=mock

# Ollama - local, no API key
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.0
OLLAMA_TOP_P=
OLLAMA_TOP_K=

# Groq - API key required; free quota availability can change
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.0
GROQ_TOP_P=

# Gemini - API key required; model support for top_k can vary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3.x: leave sampling controls blank for the normal benchmark.
# Google currently recommends model defaults; use the Parameter Lab only for deliberate experiments.
GEMINI_TEMPERATURE=
GEMINI_TOP_P=
GEMINI_TOP_K=
GEMINI_THINKING_LEVEL=minimal

# OpenAI - optional paid comparison
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=
OPENAI_TOP_P=

# OpenRouter - has free model router; API key required
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TEMPERATURE=0.0
OPENROUTER_TOP_P=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Prompt Engineering Benchmark Lab
