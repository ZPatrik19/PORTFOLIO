# Hugging Face model cache
# Optional for public models; authenticated access gives higher Hub rate limits.
HF_TOKEN=
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30
HF_XET_NUM_CONCURRENT_RANGE_GETS=4

# LLM
LLM_PROVIDER=ollama
OLLAMA_PROFILE=balanced
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=rag-qwen-balanced
OLLAMA_CONNECT_TIMEOUT_S=10
OLLAMA_READ_TIMEOUT_S=600
OLLAMA_MAX_RETRIES=1
OLLAMA_NUM_PREDICT=512

# Runtime
EXECUTION_DEVICE=auto
EMBEDDING_DEVICE=auto
RERANKER_DEVICE=auto
VECTOR_DEVICE=cpu
MAX_CONTEXT_TOKENS=3840
