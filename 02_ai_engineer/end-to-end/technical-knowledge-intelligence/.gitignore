!01_data/reference_docs/demo_*.md

# Rebuildable ingestion, index and runtime state
01_data/interim/
01_data/processed/
01_data/indexes/
08_logs/

# Local experiment traces may contain prompts, responses and private metadata
07_results/experiments/

# Build / packaging / coverage artifacts
build/
dist/
*.egg-info/
.coverage
coverage.xml
coverage.json
htmlcov/

# Notebook execution checkpoints
.ipynb_checkpoints/
